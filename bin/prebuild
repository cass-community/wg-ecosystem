#!/usr/bin/env ruby
# Pre-build step. Run before `jekyll build` (the CI workflow does this).
#
#  1. Fetches this working group's metadata from cass.community (the single
#     source of truth) and writes _data/upstream.yml. Fails loudly if the
#     fetch fails or the entry is incomplete, so a broken build never deploys.
#  2. Writes _data/navigation.yml so the nav follows `current_season`.
#
# Both outputs are generated and git-ignored. Set UPSTREAM_URL to override the
# metadata URL (used to test the failure path).

require "yaml"
require "net/http"
require "uri"
require "date"

ROOT = File.expand_path("..", __dir__)

def fail_build(msg)
  warn "\nBUILD FAILED: #{msg}\n\n"
  exit 1
end

config_path = File.join(ROOT, "site.config.yml")
fail_build("site.config.yml not found") unless File.exist?(config_path)
config = YAML.safe_load(File.read(config_path), permitted_classes: [Date]) || {}

url = ENV["UPSTREAM_URL"] || config.dig("upstream_metadata", "url")
if url.nil? || url.to_s.strip.empty? || url.to_s.start_with?("TODO")
  fail_build("site.config.yml: upstream_metadata.url is not set")
end

def fetch(url, limit = 5)
  fail_build("too many redirects fetching #{url}") if limit.zero?
  uri = URI(url)
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https",
                        open_timeout: 15, read_timeout: 30) { |h| h.get(uri.request_uri) }
  case res
  when Net::HTTPSuccess then res.body.force_encoding("UTF-8")
  when Net::HTTPRedirection then fetch(res["location"], limit - 1)
  else fail_build("fetching cass.community metadata from #{url} returned HTTP #{res.code}")
  end
rescue SocketError, SystemCallError, Timeout::Error, OpenSSL::SSL::SSLError, URI::InvalidURIError => e
  fail_build("could not fetch cass.community metadata from #{url}: #{e.class}: #{e.message}")
end

body = fetch(url)
m = body.match(/\A---\s*\n(.*?)\n---\s*(\n|\z)/m)
fail_build("#{url} has no YAML front matter; is this the right file?") unless m
begin
  upstream = YAML.safe_load(m[1], permitted_classes: [Date, Time]) || {}
rescue Psych::Exception => e
  fail_build("could not parse front matter at #{url}: #{e.message}")
end

key = config.dig("group", "upstream_key")
%w[name description meeting_schedule].each do |f|
  v = upstream[f]
  fail_build("upstream entry '#{key}' (#{url}) is missing required field '#{f}'") if v.nil? || v.to_s.strip.empty?
end

resource_links = upstream["additional_resource_links"] || []
links = {}
(config["upstream_link_labels"] || {}).each do |id, label|
  link = resource_links.find { |l| l["label"] == label }
  if link.nil? || link["url"].to_s.strip.empty?
    fail_build("upstream entry '#{key}' has no additional_resource_links item labeled '#{label}' with a url " \
               "(needed for '#{id}'; see upstream_link_labels in site.config.yml)")
  end
  links[id] = link["url"]
end

data = {
  "source" => url,
  "name" => upstream["name"],
  "description" => upstream["description"].to_s.strip,
  "meeting_schedule" => upstream["meeting_schedule"].to_s.strip,
  "links" => links
}
data_dir = File.join(ROOT, "_data")
Dir.mkdir(data_dir) unless Dir.exist?(data_dir)
File.write(File.join(data_dir, "upstream.yml"),
           "# GENERATED by bin/prebuild from cass.community. Do not edit or commit.\n" + data.to_yaml)

season = config["current_season"].to_s
season_file = File.join(ROOT, "seasons", season, "season.md")
fail_build("current_season is '#{season}' but #{season_file} does not exist") unless File.exist?(season_file)

nav = [
  { "title" => "CASS Home", "url" => "https://cass.community" },
  { "title" => "Ecosystem WG", "url" => "/" },
  { "title" => "Current season", "url" => "/seasons/#{season}/" },
  { "title" => "Resources", "url" => "/resources/" }
]
File.write(File.join(data_dir, "navigation.yml"),
           "# GENERATED by bin/prebuild from current_season. Do not edit or commit.\n" + { "main" => nav }.to_yaml)

puts "prebuild: fetched metadata for '#{upstream['name']}' from #{url}; current season #{season}"
